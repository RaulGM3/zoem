rules_version = '2';

// ============================================================================
// Zoem (vertey-b924b) — Cloud Storage Security Rules
//
// La membresía/rol ya NO se lee de Firestore (solo soporta la base (default)
// y el proyecto usa 'production-vertey'). En su lugar se usan custom claims
// escritos por las Cloud Functions syncMemberClaims y syncSuperuserClaim:
//
//   request.auth.token.companyId  — empresa a la que pertenece el usuario
//   request.auth.token.role       — Admin | Gestor | Usuario | Viewer
//   request.auth.token.estado     — activo | pendiente | ...
//   request.auth.token.isSuperUser — boolean
//
// Enforcement: aislamiento de tenant (companyId del token == cid del path)
// + rol grueso (Viewer = solo lectura). Mismo contrato que antes pero sin
// dependencia de la base de datos Firestore en las rules.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSuper() {
      return isSignedIn() && request.auth.token.get('isSuperUser', false) == true;
    }
    function isActiveMember(cid) {
      return isSignedIn()
        && request.auth.token.get('companyId', null) == cid
        && request.auth.token.get('estado', null) == 'activo';
    }
    function canWrite(cid) {
      return isActiveMember(cid) && request.auth.token.get('role', null) != 'Viewer';
    }
    // Admin + Gestor (mismo criterio que firestore.rules isManager), vía custom claim.
    function isManager(cid) {
      return isActiveMember(cid) && request.auth.token.get('role', null) in ['Admin', 'Gestor'];
    }
    // `allPaths` es de tipo path (no string, sin .matches ni string()), así que el nombre
    // completo del objeto se toma de resource.name (lectura) / request.resource.name (escritura).
    function esFacturaRecibida(nombre) {
      return nombre.matches('companies/[^/]+/facturas_recibidas/.*');
    }
    // Branding de la empresa (logo): solo Admin escribe, vía su propio match.
    function esBranding(nombre) {
      return nombre.matches('companies/[^/]+/branding/.*');
    }
    // Admin de la empresa (mismo criterio que firestore.rules isCompanyAdmin), vía custom claim.
    function isCompanyAdmin(cid) {
      return isActiveMember(cid) && request.auth.token.get('role', null) == 'Admin';
    }
    // Adjuntos de factura: PDF o imagen (la captura nativa devuelve JPEG; HEIC se rechaza en cliente).
    function tipoAdjuntoValido() {
      return request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)');
    }
    // Límite de tamaño defensivo (50 MB) en subidas.
    function withinSizeLimit() {
      return request.resource == null || request.resource.size < 50 * 1024 * 1024;
    }

    // ---- Cuota de documentos (documentosMB) -------------------------------------------------------
    // REGLA LEGAL (no negociable): NINGÚN proceso automático borra ni oculta archivos de usuario. Superar el
    // cupo (p. ej. tras bajar de plan) solo bloquea SUBIDAS NUEVAS (`create` abajo); lo ya subido sigue
    // legible (los `read` no miran el cupo) y la persona puede retirarlo ella misma (soft delete en Firestore).
    // Cuentan en `companies/{cid}/uso/total.documentosBytes` (lo mantienen las Functions a partir de los docs
    // de metadatos): TODAS las versiones de doc_files / contact_files / doc_slots, los adjuntos de
    // facturas_recibidas y las fuentes de docTemplates. Rutas exentas: branding (logo <1 MB, propio match),
    // acciones_envios (adjunto transitorio de una acción, <=10 MB, ya limitado por accionesMes), invoices
    // (PDFs que genera la app) y el HTML de docTemplates (texto). Cualquier otra ruta bajo companies/{cid}/ se
    // deniega (ver `esRutaGenerica`) para que nadie almacene datos fuera del cupo.
    // Se rechaza AQUÍ, antes de subir, para no dejar blobs huérfanos cuando Firestore rechaza después el doc.
    // Lee companies/{cid}.derechos y companies/{cid}/uso/total del Firestore (default) con firestore.get
    // (2 accesos cruzados por subida, el límite es 10). Sin `derechos` (empresa legada) no se restringe.
    // Misma semántica que firestore.rules (derechosVigentes: pasado `hasta` rige `despues`).
    // OJO: el contador es eventualmente consistente (~1 s) => límite blando, como en Firestore.
    function esArchivoContado(nombre) {
      return nombre.matches('companies/[^/]+/(casos/[^/]+/docs|contacts)/.*');
    }
    // Fuente (.pdf/.docx) subida al crear una plantilla de documento: ocupa cupo (su tamaño va en `sourceSizeBytes`).
    function esFuentePlantilla(nombre) {
      return nombre.matches('companies/[^/]+/docTemplates/[^/]+/source/.*');
    }
    // ÚNICAS rutas con escritura "genérica" (sin cupo): PDFs de factura que genera la app y HTML de plantillas.
    // Cualquier otra ruta bajo companies/{cid}/ queda denegada, para que nadie almacene datos fuera del cupo.
    function esRutaGenerica(nombre) {
      return nombre.matches('companies/[^/]+/(invoices|docTemplates)/.*') && !esFuentePlantilla(nombre);
    }
    function empresaDoc(cid) {
      return firestore.get(/databases/(default)/documents/companies/$(cid)).data;
    }
    function derechosVigentes(cid) {
      let d = empresaDoc(cid).derechos;
      return (d.hasta != null && request.time >= d.hasta) ? d.despues : d;
    }
    function usoBytes(cid) {
      let p = /databases/(default)/documents/companies/$(cid)/uso/total;
      return firestore.exists(p) ? firestore.get(p).data.get('documentosBytes', 0) : 0;
    }
    // La empresa admite escribir (no es una demo terminada) — misma regla que `escribible` de firestore.rules.
    function empresaEscribible(cid) {
      return !('derechos' in empresaDoc(cid)) || derechosVigentes(cid).soloLectura != true;
    }
    // ¿Cabe `bytes` más en el almacenamiento del plan? límite null = ilimitado.
    function hayCupoBytes(cid, bytes) {
      return !('derechos' in empresaDoc(cid))
        || derechosVigentes(cid).limites.documentosMB == null
        || usoBytes(cid) + bytes <= derechosVigentes(cid).limites.documentosMB * 1048576;
    }

    // Todo el almacenamiento del tenant.
    // Sin `delete`: los blobs nunca se borran desde cliente — el "borrado" es
    // soft delete en Firestore y el archivo se conserva para auditoría.
    //
    // LIMITACIÓN CONOCIDA (docTemplates/*): la UI gatea "editar"/"eliminar"
    // de plantillas de documento con PermissionService.can('Documentos', ...)
    // (matriz fina: override individual > rol custom > matriz de empresa >
    // base, persistida en Firestore). canWrite(cid) de abajo solo ve el rol
    // grueso vía custom claims (companyId/role/estado). Un miembro activo
    // no-Viewer puede subir/pisar el HTML de una plantilla vía llamada
    // directa a Storage aunque la matriz fina se lo niegue. Aceptado como
    // gap documentado hasta que esa matriz fina se sincronice a custom
    // claims — ver el mismo comentario en firestore.rules junto a
    // match /docTemplates/{templateId}.
    //
    // OJO: las reglas de Storage se SUMAN (basta con que una permita). Por eso
    // el bloque genérico excluye acciones_envios/ y facturas_recibidas/ — cada
    // uno tiene su propio match más estricto abajo.
    // `{allPaths=**}` se liga como `path` (sin .matches), así que el nombre se
    // mira con `request.resource.name` (create/update) o `resource.name` (read).
    function esEnvioAccion(name) {
      return name.matches('companies/[^/]+/acciones_envios/.*');
    }
    match /companies/{cid}/{allPaths=**} {
      allow read:           if (isSuper() || isActiveMember(cid)) && !esFacturaRecibida(resource.name);
      allow create, update: if !esEnvioAccion(request.resource.name)
                            && !esBranding(request.resource.name)
                            && !esFacturaRecibida(request.resource.name)
                            && !esArchivoContado(request.resource.name)
                            && esRutaGenerica(request.resource.name)
                            && (isSuper() || (canWrite(cid) && withinSizeLimit()));
      allow delete:         if isSuper();
    }

    // Archivos de casos y contactos: igual que el bloque genérico + cupo de almacenamiento (solo en `create`:
    // cada subida es un objeto nuevo con nombre único; sobrescribir no añade objetos). Demo terminada = solo lectura.
    // Lectura y borrado los siguen dando el bloque genérico (borrado: solo super).
    match /companies/{cid}/casos/{casoId}/docs/{docPaths=**} {
      allow create: if isSuper() || (canWrite(cid) && withinSizeLimit() && empresaEscribible(cid)
                                     && hayCupoBytes(cid, request.resource.size));
      allow update: if isSuper() || (canWrite(cid) && withinSizeLimit() && empresaEscribible(cid));
    }
    match /companies/{cid}/contacts/{contactPaths=**} {
      allow create: if isSuper() || (canWrite(cid) && withinSizeLimit() && empresaEscribible(cid)
                                     && hayCupoBytes(cid, request.resource.size));
      allow update: if isSuper() || (canWrite(cid) && withinSizeLimit() && empresaEscribible(cid));
    }

    // Fuente de plantillas de documento: igual que el genérico + cupo en `create` y demo terminada = solo lectura.
    match /companies/{cid}/docTemplates/{tid}/source/{srcPaths=**} {
      allow create: if isSuper() || (canWrite(cid) && withinSizeLimit() && empresaEscribible(cid)
                                     && hayCupoBytes(cid, request.resource.size));
      allow update: if isSuper() || (canWrite(cid) && withinSizeLimit() && empresaEscribible(cid));
    }

    // Logo de la empresa: companies/{cid}/branding/logo. Lectura a miembros;
    // escritura/borrado solo Admin (o super), objeto único `logo`, PNG/JPEG, < 1 MB.
    // Sin subcarpetas (`{file}` es un solo segmento) y el match genérico lo excluye.
    match /companies/{cid}/branding/{file} {
      allow read:           if isSuper() || isActiveMember(cid);
      allow create, update: if isSuper()
                            || (isCompanyAdmin(cid)
                                && file == 'logo'
                                && request.resource.size < 1024 * 1024
                                && request.resource.contentType.matches('image/(png|jpeg)'));
      allow delete:         if isSuper() || (isCompanyAdmin(cid) && file == 'logo');
    }

    // Adjuntos de facturas recibidas (libro de IVA soportado): Admin + Gestor.
    // Mismo contrato que el match genérico: sin delete de cliente (auditoría).
    match /companies/{cid}/facturas_recibidas/{facturaPaths=**} {
      allow read:           if isSuper() || isManager(cid);
      // `create` consume cupo de documentos (adjuntos de factura = documentos de la empresa).
      allow create:         if isSuper() || (isManager(cid) && withinSizeLimit() && tipoAdjuntoValido()
                                             && empresaEscribible(cid) && hayCupoBytes(cid, request.resource.size));
      allow update:         if isSuper() || (isManager(cid) && withinSizeLimit() && tipoAdjuntoValido());
      allow delete:         if isSuper();
    }

    // .docx que una acción adjunta al mensaje (lo firma accionDocUrl). Solo
    // se CREA desde cliente: sin sobrescritura ni borrado (el id es el del
    // registro, único), 10 MB máx., content-type docx, sin subcarpetas.
    match /companies/{cid}/acciones_envios/{file} {
      allow read:   if isSuper() || isActiveMember(cid);
      // `resource == null`: solo objetos nuevos (el emulator trata un overwrite
      // como `create` si no se comprueba).
      allow create: if resource == null
                    && (isSuper()
                    || (canWrite(cid)
                        && request.resource.size < 10 * 1024 * 1024
                        && request.resource.contentType ==
                           'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                        && file.matches('[A-Za-z0-9_-]+[.]docx')));
      allow update, delete: if false;
    }

    // Default fail-closed: nada fuera de companies/ es accesible.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
