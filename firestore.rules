rules_version = '2';

// ============================================================================
// Zoem (vertey-cf1b9) — Firestore Security Rules
//
// Modelo: multi-tenant. El tenant es `companies/{companyId}`.
// La membresía vive en `companies/{cid}/members/{userId}` (doc id == uid),
// lo que permite resolverla con get()/exists() SIN queries (las rules no
// pueden hacer queries).
//
// Enforcement v1: AISLAMIENTO DE TENANT + ROL GRUESO.
//   - Nadie cruza de empresa.
//   - Viewer = solo lectura.
//   - Admin (y Gestor donde aplica) gobierna config / finanzas / miembros.
//   - El superusuario (users/{uid}.isSuperUser == true) pasa por encima de todo.
// La matriz fina ver/crear/editar/eliminar por módulo sigue siendo client-side
// (UX); acá cubrimos la superficie de ataque real.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Identidad / superusuario --------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isSuper() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().isSuperUser == true;
    }

    // ---- Membresía / roles (deterministic path) ------------------------
    function memberPath(cid) {
      return /databases/$(database)/documents/companies/$(cid)/members/$(request.auth.uid);
    }
    function isMember(cid) {
      return isSignedIn() && exists(memberPath(cid));
    }
    function memberData(cid) {
      return get(memberPath(cid)).data;
    }
    function isActiveMember(cid) {
      return isMember(cid) && memberData(cid).estado == 'activo';
    }
    function hasRole(cid, roles) {
      return isActiveMember(cid) && (memberData(cid).role in roles);
    }
    function isCompanyAdmin(cid) {
      return hasRole(cid, ['Admin']);
    }
    function isManager(cid) {
      // Admin + Gestor: finanzas, facturación, tesorería
      return hasRole(cid, ['Admin', 'Gestor']);
    }
    function canWrite(cid) {
      // Cualquier miembro activo que NO sea Viewer (y la empresa no esté en solo lectura)
      return isActiveMember(cid) && memberData(cid).role != 'Viewer' && escribible(cid);
    }
    // Variantes de escritura: igual que isManager/isCompanyAdmin pero bloqueadas si la empresa está
    // en solo lectura (demo terminada). Las LECTURAS siguen usando isManager/isCompanyAdmin.
    function managerWrite(cid) {
      return isManager(cid) && escribible(cid);
    }
    function adminWrite(cid) {
      return isCompanyAdmin(cid) && escribible(cid);
    }

    // ---- Plan / derechos (fase 3) --------------------------------------
    // `companies/{cid}.derechos` es una copia DENORMALIZADA de los derechos efectivos que mantiene la
    // Function sincronizarDerechos (lógica en functions/src/planes/derechosDoc.ts, testeada). Ningún
    // cliente puede escribirla. Sin `derechos` (empresa legada) NO se restringe nada.
    //   derechos = { funciones:{...}, limites:{...|null}, soloLectura, hasta: ts|null, despues:{...}|null }
    // `hasta` es el instante en que rigen los derechos de `despues` (fin de prueba/demo): así la
    // caducidad no depende de un cron. Coste: +1 acceso (companies/{cid}), compartido por todas las
    // funciones de abajo, y +1 (uso/...) en los cupos. Los gets repetidos del mismo doc se cachean.
    function empresaDoc(cid) {
      return get(/databases/$(database)/documents/companies/$(cid)).data;
    }
    function sinDerechos(cid) {
      return !('derechos' in empresaDoc(cid));
    }
    function derechosVigentes(cid) {
      let d = empresaDoc(cid).derechos;
      return (d.hasta != null && request.time >= d.hasta) ? d.despues : d;
    }
    function tieneFuncion(cid, f) {
      return sinDerechos(cid) || derechosVigentes(cid).funciones[f] == true;
    }
    function escribible(cid) {
      return sinDerechos(cid) || derechosVigentes(cid).soloLectura != true;
    }
    // Clave del contador mensual: uso/yyyy-mm (UTC, igual que la Function).
    function mesUso() {
      return string(request.time.year()) + '-' + (request.time.month() < 10 ? '0' : '') + string(request.time.month());
    }
    function usoPath(cid, docId) {
      return /databases/$(database)/documents/companies/$(cid)/uso/$(docId);
    }
    function usoDe(cid, docId, campo) {
      return exists(usoPath(cid, docId)) ? get(usoPath(cid, docId)).data.get(campo, 0) : 0;
    }
    // Quedan `extra` unidades de cupo? limite null = ilimitado. Eventualmente consistente (soft limit).
    function hayCupo(cid, limite, docId, campo, extra) {
      return sinDerechos(cid)
        || derechosVigentes(cid).limites[limite] == null
        || usoDe(cid, docId, campo) + extra <= derechosVigentes(cid).limites[limite];
    }
    function hayCupoBytes(cid, bytes) {
      return sinDerechos(cid)
        || derechosVigentes(cid).limites.documentosMB == null
        || usoDe(cid, 'total', 'documentosBytes') + bytes <= derechosVigentes(cid).limites.documentosMB * 1048576;
    }
    // Escritura en funciones de pago: rol Admin/Gestor + función incluida en el plan + empresa escribible.
    function tesoreriaWrite(cid) {
      return managerWrite(cid) && tieneFuncion(cid, 'tesoreria');
    }
    function casoActivo(estado) {
      return estado in ['pendiente', 'en_proceso', 'urgente'];
    }

    // Valida notificationPrefs en users/{uid}: si el update NO lo toca, pasa;
    // si lo toca, debe ser un mapa con claves ⊆ permitidas y valores bool.
    function notificationPrefsValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['notificationPrefs'])
        || (request.resource.data.notificationPrefs is map
            && request.resource.data.notificationPrefs.keys()
                 .hasOnly(['llamadas', 'casos', 'contactos', 'eventos', 'hitos', 'push'])
            && (!('llamadas' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.llamadas is bool)
            && (!('casos' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.casos is bool)
            && (!('contactos' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.contactos is bool)
            && (!('eventos' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.eventos is bool)
            && (!('hitos' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.hitos is bool)
            && (!('push' in request.resource.data.notificationPrefs) || request.resource.data.notificationPrefs.push is bool));
    }

    // ====================================================================
    // users/{uid}
    // ====================================================================
    match /users/{uid} {
      allow get:    if isSuper() || request.auth.uid == uid;
      allow list:   if isSuper();
      // El superusuario crea cualquier doc; el resto solo el propio y sin autopromoción.
      allow create: if isSuper()
                    || (request.auth.uid == uid
                        && request.resource.data.isSuperUser == false);
      // El dueño edita su perfil pero NO puede tocar isSuperUser
      // notificationPrefs: mapa con claves permitidas y valores booleanos (si se toca).
      allow update: if isSuper()
                    || (request.auth.uid == uid
                        && request.resource.data.isSuperUser == resource.data.isSuperUser
                        && notificationPrefsValid());
      allow delete: if isSuper();

      // Tokens FCM del dispositivo: solo el propio usuario los gestiona.
      match /deviceTokens/{token} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'platform', 'createdAt', 'lastSeenAt'])
          && request.resource.data.token == token
          && request.resource.data.platform in ['ios', 'android', 'web'];
      }
    }

    // ====================================================================
    // companies/{cid} + subcolecciones
    // ====================================================================
    match /companies/{cid} {
      allow get:    if isSuper() || isMember(cid);
      allow list:   if isSuper();
      allow create: if isSuper();                       // alta de empresa = superusuario
      // settings + saldo bancario (tesorería). Campos de plataforma (plan, suscripcion, derechos, esDemo, autoservicio, createdBy) solo super;
      // `logo` (branding) solo Admin.
      allow update: if isSuper()
                    || (managerWrite(cid)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['plan', 'suscripcion', 'derechos', 'isActive', 'slug', 'createdAt',
                                     'esDemo', 'autoservicio', 'createdBy'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['logo'])
                            || isCompanyAdmin(cid)));
      allow delete: if isSuper();

      // ---- members: doc id == userId ---------------------------------
      function pendingInviteOk(cid) {
        let inv = get(/databases/$(database)/documents/companyInvitations/$(request.resource.data.inviteId)).data;
        return inv.status == 'pending'
          && inv.companyId == cid
          && inv.email == request.auth.token.email.lower()
          && inv.role == request.resource.data.role
          && request.time < inv.expiresAt;
      }
      function selfJoin(cid, memberUid) {
        // Auto-alta SOLO contra una invitación pendiente válida para tu email
        return memberUid == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.companyId == cid
          && request.resource.data.estado == 'activo'
          && pendingInviteOk(cid);
      }
      function onlyLoginTouched() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoLogin']);
      }

      match /members/{memberUid} {
        allow read:   if isSuper() || isMember(cid) || memberUid == request.auth.uid;
        // Alta (Admin o auto-alta por invitación) sujeta al cupo de usuarios del plan.
        allow create: if isSuper()
                      || ((adminWrite(cid) || (selfJoin(cid, memberUid) && escribible(cid)))
                          && hayCupo(cid, 'usuarios', 'total', 'usuarios', 1));
        allow update: if isSuper() || adminWrite(cid)
                      || (memberUid == request.auth.uid && onlyLoginTouched());
        allow delete: if isSuper() || adminWrite(cid);
      }

      // ---- Finanzas / tesorería: Admin + Gestor ----------------------
      // Plan: escribir exige la función `tesoreria` (free la ve pero no la escribe; nunca se borra nada:
      // al bajar de plan queda en solo lectura). Leer sigue igual.
      match /cuentas/{doc=**}                { allow read: if isSuper() || isManager(cid); allow write: if isSuper() || tesoreriaWrite(cid); }
      match /cierres_caja/{doc=**}           { allow read: if isSuper() || isManager(cid); allow write: if isSuper() || tesoreriaWrite(cid); }
      match /retiros/{doc=**}                { allow read: if isSuper() || isManager(cid); allow write: if isSuper() || tesoreriaWrite(cid); }
      match /tesoreria_meta/{doc=**}         { allow read: if isSuper() || isManager(cid); allow write: if isSuper() || tesoreriaWrite(cid); }
      match /movimientos_generales/{doc=**}  { allow read: if isSuper() || isManager(cid); allow write: if isSuper() || tesoreriaWrite(cid); }

      // ---- Facturas recibidas (libro registro + IVA soportado): Admin + Gestor ----
      // Doc id = claveFactura(nif, numero) (base64url): no se puede recomputar en rules, así
      // que la unicidad la garantiza la transacción del cliente (RIESGO RESIDUAL aceptado:
      // un Admin/Gestor malicioso podría crear con otro id; el create nunca pisa un doc existente).
      // `qrValidacion` lo escribe SOLO el servidor tras la creación (Admin SDK ignora las rules):
      // el cliente solo puede crear con 'sin_qr' | 'pendiente' y nunca modificarlo
      // (salvo reiniciarlo a sin_qr|pendiente al reactivar una anulada con otro qr).
      // Sin delete: se anula vía `estado` (el historial anuladaPor/anuladaAt se conserva al reactivar).
      match /facturas_recibidas/{facturaId} {
        function fechaIso(v) {
          return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        }
        // Valores comunes a create y update (tipos, rangos, adjunto dentro del tenant).
        function valoresValidos(d) {
          return d.companyId == cid
            && d.tipoFactura in ['F1', 'F2']
            && d.claveOperacion == '01'
            && d.estado in ['registrada', 'anulada']
            && d.numeroRecepcion is int && d.numeroRecepcion >= 1
            && d.proveedor is map
            && d.proveedor.keys().hasOnly(['nombre', 'nif', 'pais'])
            && d.proveedor.nombre is string && d.proveedor.nombre.size() > 0 && d.proveedor.nombre.size() <= 200
            && d.proveedor.nif is string && d.proveedor.nif.size() > 0 && d.proveedor.nif.size() <= 20
            && d.numero is string && d.numero.size() > 0 && d.numero.size() <= 60
            && fechaIso(d.fechaExpedicion)
            && fechaIso(d.fechaRegistro)
            && (!('fechaOperacion' in d) || fechaIso(d.fechaOperacion))
            && d.periodo303 is map
            && d.periodo303.keys().hasOnly(['ejercicio', 'trimestre'])
            && d.periodo303.ejercicio is int
            && d.periodo303.trimestre in [1, 2, 3, 4]
            && d.lineasIva is list && d.lineasIva.size() >= 1 && d.lineasIva.size() <= 20
            && d.total is number && d.total >= 0
            && d.porcentajeDeducible is number
            && d.porcentajeDeducible >= 0 && d.porcentajeDeducible <= 100
            && d.concepto is string && d.concepto.size() <= 500
            && (!('categoria' in d) || (d.categoria is string && d.categoria.size() <= 100))
            && (!('adjunto' in d)
                || (d.adjunto is map
                    && d.adjunto.storagePath is string
                    && d.adjunto.storagePath.matches('^companies/' + cid + '/facturas_recibidas/.+')))
            && (!('movimientoId' in d) || d.movimientoId is string)
            && (!('casoId' in d) || d.casoId is string)
            && d.extraccion is map
            && d.extraccion.origen in ['ia', 'qr', 'manual']
            && (!('qr' in d) || qrValido(d.qr));
        }
        // QR de la factura: mapa cerrado con tipos y longitudes acotadas (la URL se vuelve a parsear y
        // reconstruir en servidor antes de consultar a la AEAT, esto es defensa en profundidad).
        function qrValido(q) {
          return q is map
            && q.keys().hasOnly(['url', 'nif', 'numserie', 'fecha', 'importe'])
            && q.keys().hasAll(['url', 'nif', 'numserie', 'fecha', 'importe'])
            && q.url is string && q.url.size() <= 2000
            && q.nif is string && q.nif.size() <= 20
            && q.numserie is string && q.numserie.size() <= 60
            && q.fecha is string && q.fecha.size() <= 10
            && q.importe is number;
        }
        // Lo único que el cliente puede escribir en qrValidacion: estado inicial, sin datos de servidor.
        function qrValidacionCliente(v) {
          return v is map && v.keys().hasOnly(['estado']) && v.estado in ['sin_qr', 'pendiente'];
        }
        // qr/adjunto/qrValidacion: inmutables tras crear, SALVO al reactivar una anulada (los datos nuevos
        // sustituyen a los viejos). Un qr nuevo exige reiniciar qrValidacion a sin_qr|pendiente: nunca queda una
        // validación de servidor obsoleta ni una fabricada por el cliente.
        function qrAdjuntoPermitido() {
          let cambios = request.resource.data.diff(resource.data).affectedKeys();
          let reactivando = resource.data.estado == 'anulada' && request.resource.data.estado == 'registrada';
          return (!cambios.hasAny(['adjunto']) || reactivando)
            && (!cambios.hasAny(['qr']) || (reactivando && qrValidacionCliente(request.resource.data.get('qrValidacion', null))))
            && (!cambios.hasAny(['qrValidacion']) || (reactivando && qrValidacionCliente(request.resource.data.get('qrValidacion', null))));
        }
        function clavesEscribibles() {
          return ['id', 'companyId', 'numeroRecepcion', 'tipoFactura', 'claveOperacion', 'proveedor', 'numero',
                  'fechaExpedicion', 'fechaOperacion', 'fechaRegistro', 'periodo303', 'lineasIva', 'total',
                  'porcentajeDeducible', 'concepto', 'categoria', 'adjunto', 'qr', 'qrValidacion', 'extraccion',
                  'movimientoId', 'casoId', 'estado', 'anuladaPor', 'anuladaAt', 'createdBy', 'createdAt',
                  'updatedBy', 'updatedAt'];
        }
        // Claves que el cliente no puede cambiar nunca. Para corregir proveedor/número: anular y registrar de nuevo.
        function clavesInmutables() {
          return ['id', 'proveedor', 'numero', 'numeroRecepcion', 'companyId', 'createdBy', 'createdAt'];
        }
        function transicionEstadoValida() {
          let antes = resource.data.estado;
          let despues = request.resource.data.estado;
          return (
            // anular: queda constancia de quién y cuándo
            (antes == 'registrada' && despues == 'anulada'
              && request.resource.data.anuladaPor == request.auth.uid
              && request.resource.data.anuladaAt == request.time)
            // reactivar: el historial de anulación se conserva intacto
            || (antes == 'anulada' && despues == 'registrada'
              && request.resource.data.get('anuladaPor', null) == resource.data.get('anuladaPor', null)
              && request.resource.data.get('anuladaAt', null) == resource.data.get('anuladaAt', null))
            // sin cambio de estado: una anulada no se edita (solo se reactiva)
            || (antes == 'registrada' && despues == 'registrada'
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['anuladaPor', 'anuladaAt']))
          );
        }

        allow read: if isSuper() || isManager(cid);

        allow create: if (isSuper() || tesoreriaWrite(cid))
          && request.resource.data.keys().hasOnly(clavesEscribibles())
          && request.resource.data.keys().hasAll(['companyId', 'numeroRecepcion', 'tipoFactura', 'claveOperacion',
               'proveedor', 'numero', 'fechaExpedicion', 'fechaRegistro', 'periodo303', 'lineasIva', 'total',
               'porcentajeDeducible', 'concepto', 'qrValidacion', 'extraccion', 'estado', 'createdBy', 'createdAt'])
          && !request.resource.data.keys().hasAny(['anuladaPor', 'anuladaAt', 'updatedBy', 'updatedAt'])
          && valoresValidos(request.resource.data)
          && request.resource.data.estado == 'registrada'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && qrValidacionCliente(request.resource.data.qrValidacion)
          && (!('id' in request.resource.data) || request.resource.data.id == facturaId);

        allow update: if (isSuper() || tesoreriaWrite(cid))
          && resource.data.companyId == cid
          && request.resource.data.keys().hasOnly(clavesEscribibles())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(clavesInmutables())
          && valoresValidos(request.resource.data)
          && qrAdjuntoPermitido()
          && transicionEstadoValida()
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // Contador del número de recepción correlativo (art. 64 RIVA), uno por ejercicio.
      // Solo se crea con 1 y solo sube de 1 en 1 (la transacción lo incrementa junto a la factura).
      match /facturas_recibidas_meta/{ejercicio} {
        allow read: if isSuper() || isManager(cid);
        allow create: if (isSuper() || tesoreriaWrite(cid))
          && ejercicio.matches('^[0-9]{4}$')
          && request.resource.data.keys().hasOnly(['ultimo'])
          && request.resource.data.ultimo == 1;
        allow update: if (isSuper() || tesoreriaWrite(cid))
          && request.resource.data.keys().hasOnly(['ultimo'])
          && request.resource.data.ultimo == resource.data.ultimo + 1;
        allow delete: if false;
      }

      // ---- Casos (operativo) -----------------------------------------
      match /casos/{casoId} {
        allow read:  if isSuper() || isMember(cid);
        // Crear consume cupo de casos activos; reabrir un caso cerrado también (soft limit, ver hayCupo).
        allow create: if isSuper()
                      || (canWrite(cid) && hayCupo(cid, 'casosActivos', 'total', 'casosActivos', 1));
        allow update: if isSuper()
                      || (canWrite(cid)
                          && (casoActivo(resource.data.get('estado', ''))
                              || !casoActivo(request.resource.data.get('estado', ''))
                              || hayCupo(cid, 'casosActivos', 'total', 'casosActivos', 1)));
        allow delete: if isSuper() || canWrite(cid);

        // gestoría = movimientos financieros del caso → Admin/Gestor (función `tesoreria` para escribir)
        match /gestoria/{doc=**}       { allow read: if isSuper() || isManager(cid); allow write: if isSuper() || tesoreriaWrite(cid); }
        match /gestoria_slots/{doc=**} { allow read: if isSuper() || isManager(cid); allow write: if isSuper() || tesoreriaWrite(cid); }

        // documentos del caso → escritura no-Viewer, pero SIN eliminaciones
        // reales (solo soft delete vía update) y con auditoría append-only.
        // Un doc ya borrado solo lo toca el Admin (restaurar).
        match /doc_folders/{folderId} {
          allow read:   if isSuper() || isMember(cid);
          allow create: if isSuper() || canWrite(cid);
          allow update: if isSuper() || adminWrite(cid)
                        || (canWrite(cid) && resource.data.deleted != true);
          allow delete: if isSuper();

          match /doc_audit/{eventId} {
            allow read:   if isSuper() || isMember(cid);
            allow create: if isSuper()
                          || (isActiveMember(cid) && request.resource.data.userId == request.auth.uid);
            allow update, delete: if false;   // inmutable: la auditoría no se toca
          }
        }
        // Clasificados: solo Admin o la allowlist pueden leerlos. `!= true`
        // cubre docs legacy sin el campo. En `list`, las rules exigen queries
        // demostrables → los servicios usan doble query para no-admins.
        function canReadClassified(cid) {
          return resource.data.clasificado != true
            || isCompanyAdmin(cid)
            || (request.auth.uid in resource.data.get('allowedUserIds', []));
        }
        // Solo el Admin marca/desmarca clasificado o toca la allowlist.
        function classificationUntouched() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['clasificado', 'allowedUserIds']);
        }
        match /doc_slots/{slotId} {
          allow read:   if isSuper() || (isMember(cid) && canReadClassified(cid));
          allow create: if isSuper() || adminWrite(cid)
                        || (canWrite(cid) && request.resource.data.clasificado != true);
          allow update: if isSuper() || adminWrite(cid)
                        || (canWrite(cid) && resource.data.deleted != true
                            && resource.data.clasificado != true
                            && classificationUntouched());
          allow delete: if isSuper();

          match /doc_audit/{eventId} {
            allow read:   if isSuper() || isMember(cid);
            allow create: if isSuper()
                          || (isActiveMember(cid) && request.resource.data.userId == request.auth.uid);
            allow update, delete: if false;
          }
        }
        match /doc_files/{fileId} {
          allow read:   if isSuper() || (isMember(cid) && canReadClassified(cid));
          // Subir un archivo consume cupo de almacenamiento (sizeBytes frente a documentosMB).
          allow create: if isSuper()
                        || ((adminWrite(cid)
                             || (canWrite(cid) && request.resource.data.clasificado != true))
                            && hayCupoBytes(cid, request.resource.data.get('sizeBytes', 0)));
          allow update: if isSuper() || adminWrite(cid)
                        || (canWrite(cid) && resource.data.deleted != true
                            && resource.data.clasificado != true
                            && classificationUntouched());
          allow delete: if isSuper();

          match /doc_audit/{eventId} {
            allow read:   if isSuper() || isMember(cid);
            allow create: if isSuper()
                          || (isActiveMember(cid) && request.resource.data.userId == request.auth.uid);
            allow update, delete: if false;
          }
        }
      }

      // ---- Resto operativo -------------------------------------------
      match /hitos/{doc=**}          { allow read: if isSuper() || isMember(cid); allow write: if isSuper() || canWrite(cid); }
      match /hito_actividad/{doc=**} { allow read: if isSuper() || isMember(cid); allow write: if isSuper() || canWrite(cid); }
      match /eventos/{doc=**}        { allow read: if isSuper() || isMember(cid); allow write: if isSuper() || canWrite(cid); }

      // Feed ICS del calendario (suscripción webcal de solo lectura). Solo
      // las Cloud Functions (Admin SDK) crean/revocan estos docs — el
      // cliente jamás escribe. Solo puede LEER su propio doc (uid ==
      // auth.uid) para mostrar "feed activo desde…"; nunca el de otro
      // miembro. El campo `tokenHash` es un SHA-256, no el token en claro,
      // así que exponerlo en lectura no compromete el feed.
      match /calendarFeeds/{feedId} {
        allow read:  if isSuper() || (isMember(cid) && resource.data.uid == request.auth.uid);
        allow write: if false;
      }
      // Plantillas de documento: sin delete real + auditoría append-only +
      // visibilidad configurable (el html vive aquí → get protegido).
      //
      // LIMITACIÓN CONOCIDA: la UI (doc-template-detail.ts) gatea
      // "editar"/"eliminar" con PermissionService.can('Documentos', ...),
      // que resuelve override individual > rol custom > matriz de empresa >
      // base — una matriz FINA guardada en Firestore, no en custom claims.
      // Las rules de abajo solo verifican canWrite(cid)/isCompanyAdmin(cid)
      // (rol grueso vía custom claims: companyId/role/estado, ver
      // functions/src/customClaims.ts), NO esa matriz fina. Un miembro activo
      // no-Viewer puede editar/eliminar una plantilla vía devtools/llamada
      // directa a Firestore aunque la UI se lo bloquee, si su matriz fina le
      // niega 'Documentos'/'editar' o 'eliminar'. Igual que el resto del
      // fichero (ver comentario de "Enforcement v1" arriba), esto es
      // aceptado como surface de ataque no cubierta hasta que la matriz fina
      // se sincronice a custom claims (como ya se hizo con companyId/role).
      match /docTemplates/{templateId} {
        // NOTA (Judgment Day round 2 — revertido): un intento anterior quitó
        // `resource.data.deleted != true` de este `get` para que un caso que
        // ya ancló un doc_slot a esta plantilla pudiera seguir
        // regenerando/viendo el HTML aunque se hubiera soft-deleted después
        // (ver DocTemplateService.getTemplate(id, includeDeleted)). Eso
        // convertía el soft delete en un filtro puramente cosmético: CUALQUIER
        // miembro de la empresa que conociera/enumerara el templateId podía
        // leer el HTML completo de una plantilla "eliminada" para siempre vía
        // devtools/SDK directo, sin que hubiera forma de verificar en el
        // servidor que la lectura viene de un caso realmente anclado — los
        // doc_slots (companies/{cid}/casos/{casoId}/doc_slots/{slotId}) usan
        // IDs autogenerados por addDoc() y solo tienen `docTemplateId` como
        // campo, así que no hay un exists() de un único documento que pruebe
        // "existe un slot anclado a este template" sin una collection-group
        // query (que las rules no pueden expresar aquí sin restructurar datos:
        // p.ej. un doc determinista `docTemplateAnchors/{templateId}` o una
        // Cloud Function callable que sí pueda hacer esa query server-side).
        // Hasta que se implemente uno de esos dos caminos, se prioriza cerrar
        // el agujero de seguridad: se restaura el filtro `deleted != true` y
        // regenerar un documento ya anclado cuya plantilla origen se eliminó
        // después volverá a dar `permission-denied` (regresión de producto
        // aceptada, ver DocTemplateService.getTemplate JSDoc — actualizar ese
        // JSDoc/INCLUDE_DELETED en un fix de seguimiento).
        allow get:    if isSuper()
                      || (isMember(cid)
                          && resource.data.deleted != true
                          && (resource.data.get('visibleTo', 'all') != 'restricted'
                              || isCompanyAdmin(cid)
                              || (request.auth.uid in resource.data.get('visibleUserIds', []))
                              || (memberData(cid).role in resource.data.get('visibleRoles', []))));
        allow list:   if isSuper() || isMember(cid);
        allow create: if isSuper() || canWrite(cid);
        allow update: if isSuper() || adminWrite(cid)
                      || (canWrite(cid) && resource.data.deleted != true);
        allow delete: if isSuper();

        match /doc_audit/{eventId} {
          allow read:   if isSuper() || isMember(cid);
          allow create: if isSuper()
                        || (isActiveMember(cid) && request.resource.data.userId == request.auth.uid);
          allow update, delete: if false;
        }
      }
      // Plantillas de caso: el DOC raíz consume cupo al crearse (borrar lo libera); sus subcolecciones
      // (hitos, modeloCostos) no cuentan.
      match /casoPlantillas/{plantillaId} {
        allow read:   if isSuper() || isMember(cid);
        allow create: if isSuper()
                      || (canWrite(cid) && hayCupo(cid, 'plantillas', 'total', 'plantillas', 1));
        allow update, delete: if isSuper() || canWrite(cid);

        // OJO: `{sub}/{doc=**}` (subcolección + docs). Un `{sub=**}` suelto también casa con el propio
        // doc de la plantilla (cero segmentos) y regalaría el create sin pasar por el cupo.
        match /{sub}/{doc=**} {
          allow read:  if isSuper() || isMember(cid);
          allow write: if isSuper() || canWrite(cid);
        }
      }

      // ---- Acciones (mensajes plantilla con documento opcional) --------
      // Catálogo de la empresa: lo lee cualquier miembro (se ejecutan desde
      // contactos/casos); solo Admin/Gestor lo gobiernan. Esquema cerrado
      // (keys.hasOnly) para que no se cuelen campos arbitrarios.
      function accionValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['companyId', 'nombre', 'ambito', 'asunto', 'cuerpo',
                                 'docTemplateId', 'canales', 'activa', 'plantillaId',
                                 'hitoPlantillaId', 'createdBy', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['companyId', 'nombre', 'ambito', 'asunto', 'cuerpo', 'canales',
                              'activa', 'createdBy', 'createdAt', 'updatedAt'])
          && d.companyId == cid
          && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 200
          && d.ambito in ['contacto', 'caso']
          && d.asunto is string && d.asunto.size() <= 500
          && d.cuerpo is string && d.cuerpo.size() <= 10000
          && d.canales is list && d.canales.size() >= 1 && d.canales.size() <= 4
          && d.canales.hasOnly(['gmail', 'outlook', 'mail', 'whatsapp'])
          && d.activa is bool
          && (!('docTemplateId' in d) || (d.docTemplateId is string && d.docTemplateId.size() <= 200))
          && (!('plantillaId' in d) || (d.plantillaId is string && d.plantillaId.size() <= 200))
          && (!('hitoPlantillaId' in d) || (d.hitoPlantillaId is string && d.hitoPlantillaId.size() <= 200))
          && d.updatedAt == request.time;
      }
      match /acciones/{accionId} {
        allow read:   if isSuper() || isMember(cid);
        allow create: if isSuper()
                      || (managerWrite(cid)
                          && accionValida()
                          && request.resource.data.createdBy == request.auth.uid
                          && request.resource.data.createdAt == request.time);
        allow update: if isSuper()
                      || (managerWrite(cid)
                          && accionValida()
                          && request.resource.data.createdBy == resource.data.createdBy
                          && request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isSuper() || managerWrite(cid);
      }

      // Log de ejecuciones de acciones: append-only. Lo crea quien ejecuta
      // (miembro activo no-Viewer) a su nombre; nadie lo edita ni borra.
      match /accion_registros/{registroId} {
        allow read:   if isSuper() || isMember(cid);
        // Cada ejecución consume cupo del MES (uso/yyyy-mm.accionesMes).
        allow create: if isSuper()
                      || (canWrite(cid)
                          && hayCupo(cid, 'accionesMes', mesUso(), 'accionesMes', 1)
                          && request.resource.data.keys().hasOnly(['companyId', 'accionId', 'accionNombre',
                               'contactoIds', 'casoId', 'hitoId', 'canal', 'docPath', 'createdBy', 'createdAt'])
                          && request.resource.data.keys().hasAll(['companyId', 'accionId', 'accionNombre',
                               'contactoIds', 'canal', 'createdBy', 'createdAt'])
                          && request.resource.data.companyId == cid
                          && request.resource.data.createdBy == request.auth.uid
                          && request.resource.data.createdAt == request.time
                          && request.resource.data.accionId is string
                          && request.resource.data.accionNombre is string
                          && request.resource.data.accionNombre.size() <= 200
                          && request.resource.data.contactoIds is list
                          && request.resource.data.contactoIds.size() <= 100
                          && request.resource.data.canal in ['gmail', 'outlook', 'mail', 'whatsapp']
                          && (!('casoId' in request.resource.data) || request.resource.data.casoId is string)
                          && (!('hitoId' in request.resource.data) || request.resource.data.hitoId is string)
                          && (!('docPath' in request.resource.data)
                              || (request.resource.data.docPath is string
                                  && request.resource.data.docPath.matches('companies/' + cid + '/acciones_envios/[A-Za-z0-9_-]+[.]docx'))));
        allow update, delete: if false;
      }

      // ---- Cadena Verifactu (cola, cabeza, registro pendiente) --------
      // Estado interno del servidor: ningún cliente lo lee ni escribe (el Admin SDK
      // de las Cloud Functions ignora las reglas). Explícito aunque el default ya deniega.
      match /verifactuChain/{doc=**} { allow read, write: if false; }

      // Feed de actividad: cualquier miembro activo agrega; editar/borrar = Admin/Gestor
      match /actividad/{doc=**} {
        allow read:   if isSuper() || isMember(cid);
        allow create: if isSuper() || (isActiveMember(cid) && escribible(cid));
        allow update, delete: if isSuper() || managerWrite(cid);
      }

      // ---- Configuración de la empresa (matriz de permisos, etc.) ------
      // La matriz solo refina DENTRO del envelope de estas rules: el
      // enforcement grueso (Viewer read-only, finanzas Admin/Gestor) no
      // depende de este doc, así que no hace falta leerlo con get() aquí.
      match /settings/{settingId} {
        allow read:  if isSuper() || isMember(cid);
        allow write: if isSuper() || adminWrite(cid);
      }

      // ---- Contactos (subcolección: path ya scopea el tenant) ---------
      // Soft delete auditable (ContactService.deleteContact): el borrado real
      // se restringe a Super para no perder el rastro deletedAt/deletedBy.
      match /contactos/{id} {
        allow read:   if isSuper() || isMember(cid);
        allow create: if isSuper()
                      || (canWrite(cid) && hayCupo(cid, 'contactos', 'total', 'contactos', 1));
        allow update: if isSuper() || adminWrite(cid)
                      || (canWrite(cid) && resource.data.get('deleted', false) != true);
        allow delete: if isSuper();
      }

      // Contadores de uso (cupos): los mantienen las Functions con Admin SDK. Los miembros solo leen.
      match /uso/{docId} {
        allow read:  if isSuper() || isMember(cid);
        allow write: if false;
      }

      // ---- Notificaciones in-app (las crea solo el backend con Admin SDK) ---
      // El destinatario las lee y solo puede marcar `leida`.
      match /notificaciones/{notifId} {
        allow read:   if isMember(cid) && resource.data.userId == request.auth.uid;
        allow update: if isMember(cid) && resource.data.userId == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida'])
                      && request.resource.data.leida is bool;
        allow create, delete: if false;
      }

      // ---- Solicitudes de permiso al admin -----------------------------
      // Cada miembro crea las suyas (siempre 'pendiente'); solo el admin
      // resuelve. Nunca se borran: la resolución queda como registro.
      match /permission_requests/{reqId} {
        allow read:   if isSuper() || isCompanyAdmin(cid)
                      || (isActiveMember(cid) && resource.data.userId == request.auth.uid);
        allow create: if isSuper()
                      || (isActiveMember(cid) && escribible(cid)
                          && request.resource.data.userId == request.auth.uid
                          && request.resource.data.companyId == cid
                          && request.resource.data.estado == 'pendiente');
        allow update: if isSuper() || adminWrite(cid);
        allow delete: if false;
      }
    }

    // ====================================================================
    // companyInvitations/{token}  (doc id == token, un secreto bearer)
    // ====================================================================
    match /companyInvitations/{token} {
      // get por token: el doc id ES el token (UUID secreto del link de invitación).
      // El alta de un usuario NUEVO lo lee antes de autenticarse → get abierto por id.
      // No se puede enumerar: `list` queda restringido a admins/superusuario.
      allow get:    if true;
      allow list:   if isSuper() || (isSignedIn() && isCompanyAdmin(resource.data.companyId));
      // Invitar consume cupo de usuarios (el alta efectiva lo vuelve a comprobar en members).
      allow create: if isSuper()
                    || (adminWrite(request.resource.data.companyId)
                        && hayCupo(request.resource.data.companyId, 'usuarios', 'total', 'usuarios', 1));
      // El invitado puede marcar accepted; el admin gestiona todo
      allow update: if isSuper()
                    || adminWrite(resource.data.companyId)
                    || (resource.data.email == request.auth.token.email.lower()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                        && request.resource.data.status == 'accepted');
      allow delete: if isSuper() || adminWrite(resource.data.companyId);
    }

    // ====================================================================
    // Top-level con campo `companyId` (tenancy en un campo)
    // ====================================================================

    // --- Operativos: lectura miembro / escritura no-Viewer --------------
    // NOTA: `contacts` se migró a subcolección companies/{cid}/contactos
    // (path ya scopea el tenant, ver regla dentro de companies/{cid}).
    // Archivos de contacto: soft delete + auditoría inmutable + clasificados
    // (solo Admin o allowlist los leen; solo Admin gestiona la clasificación).
    match /contact_files/{fileId} {
      allow read:   if isSuper()
                    || (isMember(resource.data.companyId)
                        && (resource.data.clasificado != true
                            || isCompanyAdmin(resource.data.companyId)
                            || (request.auth.uid in resource.data.get('allowedUserIds', []))));
      allow create: if isSuper()
                    || ((adminWrite(request.resource.data.companyId)
                         || (canWrite(request.resource.data.companyId)
                             && request.resource.data.clasificado != true))
                        && hayCupoBytes(request.resource.data.companyId, request.resource.data.get('sizeBytes', 0)));
      allow update: if isSuper()
                    || ((request.resource.data.companyId == resource.data.companyId)
                        && (adminWrite(resource.data.companyId)
                            || (canWrite(resource.data.companyId)
                                && resource.data.deleted != true
                                && resource.data.clasificado != true
                                && !request.resource.data.diff(resource.data).affectedKeys()
                                    .hasAny(['clasificado', 'allowedUserIds']))));
      allow delete: if isSuper();

      match /doc_audit/{eventId} {
        // El tenant se valida contra el doc padre (+1 lectura, dedupeada).
        function parentCompany() {
          return get(/databases/$(database)/documents/contact_files/$(fileId)).data.companyId;
        }
        allow read:   if isSuper() || isMember(parentCompany());
        allow create: if isSuper()
                      || (isActiveMember(parentCompany())
                          && request.resource.data.userId == request.auth.uid
                          && request.resource.data.companyId == parentCompany());
        allow update, delete: if false;
      }
    }
    match /contact_folders/{id} {
      allow read:   if isSuper() || isMember(resource.data.companyId);
      allow create: if isSuper() || canWrite(request.resource.data.companyId);
      allow update: if isSuper()
                    || ((request.resource.data.companyId == resource.data.companyId)
                        && (adminWrite(resource.data.companyId)
                            || (canWrite(resource.data.companyId) && resource.data.get('deleted', false) != true)));
      allow delete: if isSuper();
    }
    match /documents/{id} {
      allow read:   if isSuper() || isMember(resource.data.companyId);
      allow create: if isSuper() || canWrite(request.resource.data.companyId);
      allow update: if isSuper() || (canWrite(resource.data.companyId)
                      && request.resource.data.companyId == resource.data.companyId);
      allow delete: if isSuper() || canWrite(resource.data.companyId);
    }
    // Recepción IA: la función `recepcionIA` del plan es requisito para ESCRIBIR (leer sigue permitido).
    match /iaContacts/{id} {
      allow read:   if isSuper() || isMember(resource.data.companyId);
      allow create: if isSuper() || (canWrite(request.resource.data.companyId)
                      && tieneFuncion(request.resource.data.companyId, 'recepcionIA'));
      allow update: if isSuper() || (canWrite(resource.data.companyId)
                      && tieneFuncion(resource.data.companyId, 'recepcionIA')
                      && request.resource.data.companyId == resource.data.companyId);
      allow delete: if isSuper() || (canWrite(resource.data.companyId)
                      && tieneFuncion(resource.data.companyId, 'recepcionIA'));
    }
    // Plantillas: soft delete + auditoría inmutable + visibilidad configurable.
    // El CONTENIDO se protege en `get`; el `list` sigue abierto a miembros
    // (metadatos) y el cliente filtra con canSeePlantilla() — tradeoff documentado.
    match /plantilla_files/{fileId} {
      allow get:    if isSuper()
                    || (isMember(resource.data.companyId)
                        && (resource.data.get('visibleTo', 'all') != 'restricted'
                            || isCompanyAdmin(resource.data.companyId)
                            || (request.auth.uid in resource.data.get('visibleUserIds', []))
                            || (memberData(resource.data.companyId).role
                                in resource.data.get('visibleRoles', []))));
      allow list:   if isSuper() || isMember(resource.data.companyId);
      allow create: if isSuper() || canWrite(request.resource.data.companyId);
      allow update: if isSuper()
                    || ((request.resource.data.companyId == resource.data.companyId)
                        && (adminWrite(resource.data.companyId)
                            || (canWrite(resource.data.companyId) && resource.data.deleted != true)));
      allow delete: if isSuper();

      match /doc_audit/{eventId} {
        function parentCompany() {
          return get(/databases/$(database)/documents/plantilla_files/$(fileId)).data.companyId;
        }
        allow read:   if isSuper() || isMember(parentCompany());
        allow create: if isSuper()
                      || (isActiveMember(parentCompany())
                          && request.resource.data.userId == request.auth.uid
                          && request.resource.data.companyId == parentCompany());
        allow update, delete: if false;
      }
    }
    match /plantilla_folders/{id} {
      allow read:   if isSuper() || isMember(resource.data.companyId);
      allow create: if isSuper() || canWrite(request.resource.data.companyId);
      allow update: if isSuper()
                    || ((request.resource.data.companyId == resource.data.companyId)
                        && (adminWrite(resource.data.companyId)
                            || (canWrite(resource.data.companyId) && resource.data.get('deleted', false) != true)));
      allow delete: if isSuper();
    }
    match /projects/{id} {
      allow read:   if isSuper() || isMember(resource.data.companyId);
      allow create: if isSuper() || canWrite(request.resource.data.companyId);
      allow update: if isSuper() || (canWrite(resource.data.companyId)
                      && request.resource.data.companyId == resource.data.companyId);
      allow delete: if isSuper() || canWrite(resource.data.companyId);
    }

    // --- Financiero: Admin + Gestor solamente ---------------------------
    // `verifactu` (estado, huella, QR, CSV, cola) lo escribe SOLO el servidor
    // (Cloud Functions con Admin SDK, que ignora estas reglas). Ningún cliente,
    // ni siquiera Admin/Gestor/superusuario, puede crearlo, modificarlo ni borrarlo.
    match /invoices/{id} {
      // Verdadero si la escritura cambia `verifactu` (añadir, cambiar cualquier
      // subcampo, o eliminarlo). affectedKeys() solo lista las claves de primer
      // nivel que difieren, y `verifactu.estado = x` cambia la clave `verifactu`.
      // Reenviar el MISMO valor sin cambios no cuenta como modificación.
      function verifactuIntacto() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifactu']);
      }
      // Registro Verifactu "vivo": ya reservado en la cadena del emisor (en cola,
      // pendiente de AEAT o aceptado). Borrar la factura dejaría un eslabón huérfano.
      // `error` y 'no_aplica' (legacy) o ausencia NO bloquean el borrado.
      function verifactuVivo() {
        return resource.data.get('verifactu', {}).get('estado', '') in ['en_cola', 'pendiente', 'enviado'];
      }

      allow read:   if isSuper() || isManager(resource.data.companyId);
      // Plan: escribir exige la función `facturacion` (leer sigue permitido tras bajar de plan).
      allow create: if (isSuper() || (managerWrite(request.resource.data.companyId)
                        && tieneFuncion(request.resource.data.companyId, 'facturacion')))
                    && !('verifactu' in request.resource.data);
      allow update: if (isSuper() || (managerWrite(resource.data.companyId)
                        && tieneFuncion(resource.data.companyId, 'facturacion')
                        && request.resource.data.companyId == resource.data.companyId))
                    && verifactuIntacto();
      allow delete: if (isSuper() || (managerWrite(resource.data.companyId)
                        && tieneFuncion(resource.data.companyId, 'facturacion')))
                    && !verifactuVivo();
    }

    // ====================================================================
    // agentMappings/{agentId}  → mapeo agentId → company (RecepciónIA)
    // doc id == agentId, en su propia colección (NO en companies).
    // Escritura SOLO superusuario; lectura: super o miembros de esa company.
    // ====================================================================
    match /agentMappings/{agentId} {
      allow read:  if isSuper() || isMember(resource.data.companyId);
      allow write: if isSuper();
    }

    // ====================================================================
    // llamadas/{id}  → aisladas por el agentId vía agentMappings.
    // Una empresa solo ve las llamadas cuyo agentId tiene registrado.
    // Las crea/borra un backend (webhook IA) → cliente = solo superusuario.
    // ====================================================================
    match /llamadas/{id} {
      function callCompanyId() {
        return get(/databases/$(database)/documents/agentMappings/$(resource.data.agentId)).data.companyId;
      }
      function callMapped() {
        return resource.data.agentId != null
          && exists(/databases/$(database)/documents/agentMappings/$(resource.data.agentId));
      }
      allow read: if isSuper() || (callMapped() && isMember(callCompanyId()));
      // update operativo (descartar / asociar contacto) sin reasignar el agentId.
      // canWrite (no isMember) → un Viewer NO puede modificar llamadas.
      allow update: if isSuper()
        || (callMapped()
            && canWrite(callCompanyId())
            && tieneFuncion(callCompanyId(), 'recepcionIA')
            && request.resource.data.agentId == resource.data.agentId);
      allow create, delete: if isSuper();
    }

    // ====================================================================
    // COLLECTION GROUP QUERIES
    // Las reglas ANIDADAS (match /companies/{cid}/.../x) NO autorizan
    // collection group queries — Firestore exige una regla a nivel raíz con
    // wildcard recursivo `{path=**}`. Como en este scope `cid` no es una
    // variable limpia del path, autorizamos por el CAMPO que el query filtra.
    // ====================================================================

    // collectionGroup('members') where userId == uid  → loadMyCompanies()
    // Cada user solo ve SUS propias membresías (el query ya filtra por userId).
    match /{path=**}/members/{memberUid} {
      allow read: if isSuper() || resource.data.userId == request.auth.uid;
    }

    // collectionGroup('gestoria') where companyId == cid → loadTodosMovimientos()
    // Financiero → Admin/Gestor de la empresa dueña de los movimientos.
    match /{path=**}/gestoria/{doc} {
      allow read: if isSuper() || isManager(resource.data.companyId);
    }

    // collectionGroup('extracto') where companyId == cid → loadLineas()
    // Conciliación bancaria (financiero) → Admin/Gestor de esa empresa.
    match /{path=**}/extracto/{doc} {
      allow read: if isSuper() || isManager(resource.data.companyId);
    }

    // ====================================================================
    // app_errors: cualquier usuario autenticado puede crear su propio log;
    // solo el superuser puede leer la colección completa.
    // ====================================================================
    match /app_errors/{errorId} {
      allow create: if isSignedIn();
      allow read: if isSuper();
    }

    // ====================================================================
    // Default: TODO lo no declarado queda DENEGADO (fail-closed).
    // Colecciones nuevas necesitan su propia regla explícita.
    // ====================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
